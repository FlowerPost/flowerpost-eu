# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# blender
# flowerpost-box.blend itself IS tracked (single source of truth for the
# 3D asset, regenerated via blender/build_box.py) — only ignore its
# auto-generated numbered backups and lock files. If the .blend ever
# exceeds ~5MB, switch it to Git LFS (`git lfs track "*.blend"`) instead
# of ignoring it.
blender/*.blend1
blender/*.blend2
blender/*.blend[0-9]
*.blend@
